/* Box Model Reset */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
  background-color: #f4f7f6;
  color: #333;
  padding: 40px 20px;
}

.section-title {
  text-align: center;
  margin-bottom: 30px;
  font-size: 2rem;
  color: #2c3e50;
}

/* Flexbox Container: Desktop par 3 cards ek row mein */
.card-container {
  display: flex;
  justify-content: center;
  gap: 25px;
  max-width: 1100px;
  margin: 0 auto;
}

/* Card Styling & Box Model (Margin, Padding, Border) */
.profile-card {
  background-color: #ffffff;
  border: 1px solid #e0e0e0;
  border-radius: 12px;
  padding: 25px;
  flex: 1;
  max-width: 340px;
  text-align: center;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.06);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}


.profile-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 12px 20px rgba(0, 0, 0, 0.12);
}


.profile-img {
  width: 110px;
  height: 110px;
  border-radius: 50%;
  object-fit: cover;
  border: 3px solid #3498db;
  margin-bottom: 15px;
}

.profile-name {
  font-size: 1.4rem;
  margin-bottom: 8px;
  color: #2c3e50;
}

.profile-desc {
  font-size: 0.95rem;
  color: #666;
  margin-bottom: 18px;
  line-height: 1.4;
}


.skills-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  margin-bottom: 20px;
}

.skill-tag {
  background-color: #eef7fa;
  color: #2980b9;
  font-size: 0.8rem;
  font-weight: 600;
  padding: 5px 12px;
  border-radius: 20px;
}


.view-btn {
  background-color: #3498db;
  color: #ffffff;
  border: none;
  padding: 10px 20px;
  font-size: 0.95rem;
  font-weight: 600;
  border-radius: 6px;
  cursor: pointer;
  width: 100%;
  transition: background-color 0.2s ease;
}

.view-btn:hover {
  background-color: #2980b9;
}


.extra-info {
  display: none;
  margin-top: 15px;
  padding-top: 12px;
  border-top: 1px dashed #ccc;
  font-size: 0.9rem;
  color: #393737;
}


@media (max-width: 768px) {
  .card-container {
    flex-direction: column;
    align-items: center;
  }

  .profile-card {
    width: 100%;
    max-width: 400px;
  }
}